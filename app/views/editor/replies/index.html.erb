<div class="community-container mt-8">
  <div class="prose dark:prose-invert">
    <h1>
      <%= title "Replies" %>
      <% if @post.present? %> - <%= link_to @post.title, editor_post_path(@post) %><% end %>
      <% if @community.present? %> - <%= link_to @community.name, editor_community_path(@community) %><% end %>

      <span class="text-gray-500">
        <%= @pagy.page > 1 ? '(Page ' + @pagy.page.to_s + ')' : " (#{number_with_delimiter(@post.present? ? @post.replies.count : @community.present? ? @community.replies.count : Reply.count)})" %>
      </span>
    </h1>
  </div>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="min-w-full divide-y divide-gray-300 dark:divide-gray-700">
          <thead>
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 dark:text-gray-100 sm:pl-3">created_at</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Community</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Post</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Author</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Body</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-3">
                <span class="sr-only">View</span>
              </th>
            </tr>
          </thead>
          <tbody class="">
            <% @replies.each do |reply| %>
              <tr class="even:bg-gray-050 dark:even:bg-gray-950">
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 dark:text-gray-100 sm:pl-3">
                  <%= relative_time_tag(reply.created_at) %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= reply.post.community.icon.attached? ? image_tag(reply.post.community.icon.variant(resize_to_limit: [32, 32]), class: "inline-block align-middle mr-2", width: 16, height: 16) : "" %>
                  <a href="<%= editor_community_path(reply.post.community) %>" class="link" target="_blank" rel="nofollow noopener">
                    <%= truncate(reply.post.community.name, length: 30) %>
                  </a>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <a href="<%= editor_post_path(reply.post) %>" class="link" target="_blank" rel="nofollow noopener">
                    <%= truncate(reply.post.title, length: 30) %>
                  </a>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= reply.member.photo.attached? ? image_tag(reply.member.photo.variant(resize_to_limit: [32, 32]), class: "inline-block align-middle mr-2 rounded-full", width: 16, height: 16) : "" %>
                  <a href="<%= editor_member_path(reply.member.id) %>" class="link" target="_blank" rel="nofollow noopener">
                    <%= truncate(reply.member.name, length: 30) %>
                  </a>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= truncate(strip_tags(reply.body.to_plain_text), length: 50) %>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-3">
                  <a href="<%= editor_reply_path(reply) %>" class="link">View →<span class="sr-only"></span></a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>


<% if @pagy.next %>
  <div class="text-center my-4">
    <%= link_to 'Next →', editor_replies_path(page: @pagy.next, community_id: params[:community_id], post_id: params[:post_id]), class: 'btn btn-primary' %>
  </div>
<% end %>
