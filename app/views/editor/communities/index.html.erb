<div class="community-container mt-8">
  <div class="prose dark:prose-invert">
    <h1><%= title 'Communities' %> <span class="text-gray-500"><%= @pagy.page > 1 ? '(Page ' + @pagy.page.to_s + ')' : " (#{number_with_delimiter(Community.count.to_s)})" %></span></h1>
  </div>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="min-w-full divide-y divide-gray-300 dark:divide-gray-700">
          <thead>
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 dark:text-gray-100 sm:pl-3">Name</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Posts</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Active members</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Invitations</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Owner</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-3">
                <span class="sr-only">View</span>
              </th>
            </tr>
          </thead>
          <tbody class="">
            <% @communities.each do |community| %>
              <tr class="even:bg-gray-050 dark:even:bg-gray-950">
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 dark:text-gray-100 sm:pl-3">
                  <%= community.icon.attached? ? image_tag(community.icon.variant(resize_to_limit: [32, 32]), class: "inline-block align-middle mr-2", width: 16, height: 16) : "" %>
                  <a href="<%= community.url %>" class="link" target="_blank" rel="nofollow noopener">
                    <%= truncate(community.name, length: 30) %>
                  </a>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= community.posts.count %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= community.members.active.count %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= community.members.invited.count %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= community.email %></td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-3">
                  <a href="<%= editor_community_path(community) %>" class="link">View →<span class="sr-only"></span></a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>


<% if @pagy.next %>
  <div class="text-center my-4">
    <%= link_to 'Next →', editor_communities_path(page: @pagy.next), class: 'btn btn-primary' %>
  </div>
<% end %>


