<div class="community-container mt-8">
  <div class="prose dark:prose-invert">
    <h1>
      <%= title "Posts" %>
      <% if @community.present? %> - <%= link_to @community.name, editor_community_path(@community) %><% end %>

      <span class="text-gray-500">
        <%= @pagy.page > 1 ? '(Page ' + @pagy.page.to_s + ')' : " (#{number_with_delimiter(@community.present? ? @community.posts.count : Post.count)})" %>
      </span>
    </h1>
  </div>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-900">
          <thead>
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 dark:text-gray-100 sm:pl-3">Published</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Community</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Author</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Title</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-3">
                <span class="sr-only">View</span>
              </th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-3">
                <span class="sr-only">Replies</span>
              </th>
            </tr>
          </thead>
          <tbody class="">
            <% @posts.each do |post| %>
              <tr class="even:bg-gray-050 dark:even:bg-gray-950">
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 dark:text-gray-100 sm:pl-3">
                  <%= relative_time_tag(post.published_at) %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= post.community.icon.attached? ? image_tag(post.community.icon.variant(resize_to_limit: [32, 32]), class: "inline-block align-middle mr-2", width: 16, height: 16) : "" %>
                  <a href="<%= editor_community_path(post.community) %>" class="link" target="_blank" rel="nofollow noopener">
                    <%= truncate(post.community.name, length: 30) %>
                  </a>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= post.member.photo.attached? ? image_tag(post.member.photo.variant(resize_to_limit: [32, 32]), class: "inline-block align-middle mr-2 rounded-full", width: 16, height: 16) : "" %>
                  <a href="<%= editor_member_path(post.member.id) %>" class="link" target="_blank" rel="nofollow noopener">
                    <%= truncate(post.member.name, length: 30) %>
                  </a>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= truncate(post.title, length: 50) %>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-3">
                  <a href="<%= editor_post_path(post) %>" class="link">View →<span class="sr-only"></span></a>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-3">
                  <% if post.replies.count > 0 %>
                    <a href="<%= editor_replies_path(post, post_id: post.id) %>" class="link">Replies (<%= post.replies.count %>)<span class="sr-only"></span></a>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>


<% if @pagy.next %>
  <div class="text-center my-4">
    <%= link_to 'Next →', editor_posts_path(page: @pagy.next, community_id: params[:community_id]), class: 'btn btn-primary' %>
  </div>
<% end %>


