<div class="px-8 pt-8 pb-12 md:flex md:justify-between md:pt-12 md:pb-16 lg:px-12">
  <div class="mt-4 text-xl font-bold text-gray-900 dark:text-gray-100 md:text-3xl md:mt-0">
    <span class="font-bold">Booklet Growth</span>
    <span class="font-semibold">
    <% if @contacted_change.present? %>
      <% if @contacted_change.positive? %>
        <span class="text-accent">+<%= number_to_percentage(@contacted_change, precision: 2) %> WoW</span>
      <% else %>
        <span class="text-gray-600 dark:text-gray-400"><%= number_to_percentage(@contacted_change, precision: 2) %> WoW</span>
      <% end %>
    <% end %>
  </div>
</div>
<%= line_chart growth_chart_data_path,
  stacked: false,
  discrete: true, curve: false, points: false,
  legend: false, prefix: "", thousands: ",",
  dataset: { fill: 'origin' }, width: '100%',
  height: '70vh', refresh: 60 %>
