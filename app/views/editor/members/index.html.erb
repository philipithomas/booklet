<div class="community-container mt-8">
  <div class="prose dark:prose-invert">
    <h1>
      <%= title "Members" %>
      <% if @community.present? %> - <%= link_to @community.name, editor_community_path(@community) %><% end %>
      <% if @email.present? %> - <%= @email %><% end %>
      <span class="text-gray-500">
        <%= case
        when @community.present?
          " (#{number_with_delimiter(@community.members.count)})"
        when @email.present?
          " (#{number_with_delimiter(Member.where(email: @email).count)})"
        else
          " (#{number_with_delimiter(Member.count)})"
        end %>
      </span>
    </h1>
  </div>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <table class="min-w-full divide-y divide-gray-300 dark:divide-gray-700">
          <thead>
            <tr>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Name</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Community</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Email</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Permission</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Confirmed</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">State</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">Invited By</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-3">
                <span class="sr-only">View</span>
              </th>
            </tr>
          </thead>
          <tbody class="">
            <% @members.each do |member| %>
              <tr class="even:bg-gray-050 dark:even:bg-gray-950">
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= member.photo.attached? ? image_tag(member.photo.variant(resize_to_limit: [32, 32]), class: "inline-block align-middle mr-2 rounded-full", width: 16, height: 16) : "" %>
                  <%= member.name %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= member.community.icon.attached? ? image_tag(member.community.icon.variant(resize_to_limit: [32, 32]), class: "inline-block align-middle mr-2", width: 16, height: 16) : "" %>
                  <a href="<%= editor_community_path(member.community) %>" class="link" target="_blank" rel="nofollow noopener">
                    <%= member.community.name %>
                  </a>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= member.email %>
                  <% if Member.where(email: member.email).count > 1 %>
                    <span class="text-gray-500">
                      (
                        <a href="<%= editor_members_path(email: member.email) %>" class="link" target="_blank" rel="nofollow noopener">
                          Filter <%= Member.where(email: member.email).count %>
                        </a>
                      )
                    </span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= member.permission %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= member.confirmed_at %>
                </td>

                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <% if member.locked_at %>
                    <div class="inline-block px-2 text-xs font-semibold leading-5 text-red-800 bg-red-100 rounded-full">
                      Locked
                    </div>
                  <% end %>
                  <% if member.quarantined_at %>
                    <div class="inline-block px-2 text-xs font-semibold leading-5 text-yellow-800 bg-yellow-100 rounded-full">
                      Quarantined
                    </div>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%=link_to member.invited_by.name, editor_member_path(member.invited_by) if member.invited_by.present? %>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-3">
                  <%= link_to 'View →', editor_member_path(member), class: 'link' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>


<% if @pagy.next %>
  <div class="text-center my-4">
    <%= link_to 'Next →', editor_members_path(page: @pagy.next, email: params[:email], community_id: params[:community_id]), class: 'btn btn-primary' %>
  </div>
<% end %>


