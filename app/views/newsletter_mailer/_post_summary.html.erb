<% member = post.member %>
<div>
  <a href="<%= post_url(post, host: @community.host, email_token: @email_token) %>">
    <span class="font-semibold"><%= post.title %></span>
  </a>
  <table class="mx-0" style="margin: 0 0 0 0" cellpadding="0" cellspacing="0" role="presentation">
    <tbody>
      <tr >
        <td class="pb-2">
          <div>
            <a href="<%= member_url(member, host: @community.host, email_token: @email_token) %>" target="_blank">
                <div>
                  <%= image_tag member.photo.attached? ? member.photo.variant(resize_to_fill: [40, 40, { crop: :attention }]).processed : (@community.icon.attached? ? @community.icon.variant(resize_to_fill: [40, 40, { crop: :attention }]).processed : asset_path('logo/icon.png')),
                    width: 20, height: 20,
                    class: member.photo.attached? ? "border-0 rounded-full h-20 w-20" : "border-0 h-20 w-20",
                    alt: member.photo.attached? ? member.name : @community.name %>
                </div>
            </a>
          </div>
        </td>
        <td class="">
          <div class="ml-8 leading-tight">
            <div class="">
              <a href="<%= member_url(member, host: @community.host, email_token: @email_token) %>" target="_blank" style="text-decoration: none !important;">
                <span class="text-sm font-medium text-gray-600">
                  <%= member.name %>
                </span>
              </a>
            </div>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
  <a href="<%= post_url(post, host: @community.host, email_token: @email_token) %>" style="text-decoration: none !important;">
    <div class="text-sm text-gray-600" style="padding-top: 4px;">
      <span class="font-semibold">⚡️ <%= t "mailers.new_newsletter.new" %>:</span>
      <%= @newsletter.new_post_summary(post) %>
    </div>
  </a>
</div>