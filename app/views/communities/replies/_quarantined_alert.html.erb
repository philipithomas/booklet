<div class="card mt-8">
  <div class="flex sm:items-center">
    <div class="flex-shrink-0">
      <%= heroicon "exclamation-triangle", options: { class: "h-5 w-5 text-accent" } %>
    </div>
    <div class="ml-3 flex-1 sm:flex sm:justify-between sm:items-center">
      <p class="text-sm font-semibold text-gray-700 dark:text-gray-200">
        <%= t ".reply_quarantined" %>
      </p>
      <div class="mt-3 text-sm sm:ml-6 sm:mt-0">
        <%= button_to post_reply_path(reply.post, reply, reply: { quarantined_at: nil }),
            class: "btn btn-small btn-primary",
            method: :patch,
            form: {
              data: {
                turbo_confirm: t('.are_you_sure_you_want_to_remove_quarantine'),
              }
            } do %>
          <%= t ".remove_quarantine" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
