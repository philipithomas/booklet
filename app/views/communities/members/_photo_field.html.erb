<div data-controller="upload">
  <%= f.label :photo, 'Photo', class: 'cursor-pointer' do %>
    <div class="form-label">Photo</div>
    <div class="mt-2">
      <div class="flex items-center">
        <img
          class="w-16 h-16 m-1 overflow-hidden bg-gray-500 rounded-full md:w-24 md:h-24"
          data-upload-target="preview"
          <% if f.object.photo.attached? %>src="<%= cdn_proxy_url(f.object.photo.variant(:thumb)) %>"<% end %>
          >
        <%= f.file_field :photo,
          accept: "image/png,image/gif,image/jpeg",
          direct_upload: true,
          class: "hidden",
          data: { upload_target: 'input', action: "change->upload#uploadFile" }
        %>
        <%= render "components/shared/upload_button" %>
      </div>
    </div>
  <% end %>
</div>