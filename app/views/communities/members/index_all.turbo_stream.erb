<%= turbo_stream.append "all_members", partial: "communities/members/all/rows", locals: { members: @members } %>

<% if @pagy.next.present? %>
  <%= turbo_stream.replace "infinite_scroll",
    partial: "communities/members/all/scroll_frame",
    locals: { page: @pagy.next } %>
<% else %>
  <%= turbo_stream.remove "infinite_scroll" %>
<% end %>
