<% content_for :title do %>
  <%= title t('.title') %>
<% end %>

<%= render 'communities/members/header', community: @community, current_member: current_member %>

<div class="community-page-vertical-padding">
  <% if MemberPolicy.new(current_member, @community).index_all? %>
    <%= render 'tabs' %>
  <% end %>

  <%= render "components/member/list", members: @members %>
</div>
