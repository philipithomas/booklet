<%# locals: (api_keys:) -%>

<% if api_keys.any? %>
  <div class="inline-block w-full align-middle w-full overflow-x-scroll pb-8">
    <table class="w-full max-w-prose table-fixed">
      <thead class="sr-only">
        <tr>
          <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 dark:text-gray-100 sm:pl-6">
            <%= I18n.t("activerecord.attributes.api_key.name") %>
          </th>
          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 dark:text-gray-100">
            <%= I18n.t("activerecord.attributes.api_key.last_used_at") %>
          </th>
          <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
            <span class="sr-only">
              <%= I18n.t("communities.settings.api_keys.actions.delete") %>
            </span>
          </th>
        </tr>
      </thead>
      <tbody class="" id="api_keys">
        <% api_keys.each do |api_key| %>
          <tr id="<%= dom_id(api_key) %>">
            <td class="px-3 py-3.5 text-left text-sm text-gray-900 dark:text-gray-100 font-semibold truncate">
              <%= api_key.name %>
            </td>
            <td class="px-3 py-3.5 text-left text-sm text-gray-800 font-light dark:text-gray-200 truncate">
              <%= api_key.last_used_at ? relative_time_tag(api_key.last_used_at) : t(".never_used") %>
            </td>
            <td class="px-3 py-3.5 text-left text-sm text-gray-900">
              <%= button_to settings_api_key_path(api_key.id), method: :delete, data: { turbo_confirm: t(".confirm_delete") }, class: "text-gray-500 hover:text-gray-700" do %>
                <%= heroicon "x-mark", options: { class: "inline-block w-5 h-5 ml-1 text-gray-500 hover:text-gray-700 dark:text-gray-600 dark:hover:text-gray-700 shrink-0" } %>
                <span class="sr-only">
                  <%= t(".delete") %>
                </span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
