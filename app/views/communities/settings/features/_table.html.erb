<%# locals: (community:) %>

<ul role="list" class="divide-y divide-gray-100 dark:divide-gray-800 overflow-hidden bg-white dark:bg-gray-950 shadow-sm ring-1 ring-gray-900/5 dark:ring-gray-100/5 dark:border dark:border-gray-900 sm:rounded-xl">
  <li class="relative">
    <a href="<%= settings_feature_path(:directory) %>" class=" flex justify-between gap-x-6 px-4 py-5 hover:bg-gray-050 dark:hover:bg-gray-900 sm:px-6">
      <div class="flex min-w-0 gap-x-4 text-base font-medium text-gray-900 dark:text-gray-100">
        <%= title I18n.t('communities.settings.features.directory.title') %>
      </div>
      <div class="flex shrink-0 items-center gap-x-4">
        <div class="hidden sm:flex sm:flex-col sm:items-end">
          <% if community.directory_enabled? %>
            <%= render "communities/settings/features/enabled" %>
          <% else %>
            <%= render "communities/settings/features/disabled" %>
          <% end %>
        </div>
        <%= heroicon "chevron-right", options: { class: "h-5 w-5 flex-none text-gray-400 dark:text-gray-600" } %>
      </div>
    </a>
  </li>
  <li class="relative">
    <a href="<%= settings_feature_path(:email_visibility) %>" class=" flex justify-between gap-x-6 px-4 py-5 hover:bg-gray-050 dark:hover:bg-gray-900 sm:px-6">
      <div class="flex min-w-0 gap-x-4 text-base font-medium text-gray-900 dark:text-gray-100">
        <%= title I18n.t('communities.settings.features.email_visibility.title') %>
      </div>
      <div class="flex shrink-0 items-center gap-x-4">
        <div class="hidden sm:flex sm:flex-col sm:items-end">
          <span class="text-sm text-gray-800 dark:text-gray-200 font-normal">
            <%= community.email_visibility.humanize %>
          </span>
        </div>
        <%= heroicon "chevron-right", options: { class: "h-5 w-5 flex-none text-gray-400 dark:text-gray-600" } %>
      </div>
    </a>
  </li>

</ul>
