<%= turbo_stream.append "posts", partial: "components/post/cards", locals: { posts: @posts } %>

<% if @pagy.next.present? %>
  <%= turbo_stream.replace "infinite_scroll",
    partial: "components/post/scroll_frame",
    locals: { page: @pagy.next } %>
<% else %>
  <%= turbo_stream.remove "infinite_scroll" %>
<% end %>
