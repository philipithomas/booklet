<div data-controller="color-picker">
  <%= f.label :brand_color, class: 'form-label' %>
  <div class="mt-1">
    <div class="flex max-w-xs rounded-md shadow-sm">
      <span class="inline-flex items-center px-3 text-gray-500 border border-r-0 border-gray-300 dark:border-gray-800 rounded-l-md bg-gray-050 dark:bg-gray-900">
        #
      </span>
      <input data-action="input->color-picker#update_form" data-color-picker-target="color"
            id="brand_color" name="community[brand_color]" type="color" value="<%= community.brand_color %>"
            class="flex-1 block w-24 h-8 mt-0 border border-gray-300 dark:border-gray-700 p-0 m-0 shadow-sm focus:ring-accent-500 focus:border-accent-500 sm:text-sm rounded-l-none rounded-r-md bg-gray-050 dark:bg-gray-900" />
    </div>
  </div>
</div>
