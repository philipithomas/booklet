<%= turbo_frame_tag dom_id(post) do %>
  <div
    data-controller="post"
    data-post-id="<%= post.id %>"
    data-post-member-id-value="<%= post.member_id %>"
    class="flex flex-col justify-between items-center"
    >
    <%= render 'components/post/components/dropdown', post: post %>
    <h1 class="page-title block text-center lg:max-w-[80%] text-pretty">
      <a href="<%= post_path(post) %>" class="inline">
        <%= post.title %>
      </a>
    </h1>
    <div class="text-sm font-light text-gray-700 dark:text-gray-300 pt-2">
      <%= t('communities.posts.show.posted') %> <%= relative_time_tag(post.published_at) %>.
    </div>

    <article class="mt-6 w-full max-w-prose" data-controller="linkout medium-zoom">
      <%= post.body %>
    </article>

    <div class="mt-8 w-full max-w-prose">
      <div class="flex justify-between items-center">
        <div>
          <%= render :partial => 'components/member/inline', locals: { member: post.member } %>
        </div>
        <div>
          <turbo-frame
            id="post_views"
            src="<%= post_views_path(post) %>">
          </turbo-frame>
        </div>
      </div>
    </div>
  </div>
<% end %>
