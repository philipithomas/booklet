<% cache ["member", member.id, member.updated_at] do %>
<li>
  <a href="<%= member_path(member) %>" target="_top" class="text-center">
    <%= render :partial => 'components/member/photo', locals: { member: member, size: 24, class: "mx-auto block" } %>
    <span class="block mt-4 text-sm font-medium leading-7 tracking-tight text-gray-900 dark:text-gray-100 truncate">
      <%= member.name %>
    </span>
    <%# Might reactivate this when person has a headline
      <span class="text-sm font-light text-gray-500 truncate">Headline</span>
      %>
  </a>
</li>
<% end %>