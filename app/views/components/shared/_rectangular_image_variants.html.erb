<% unless image.variable? %>
  <img class="<%= classes %>"
    src="<%= cdn_proxy_url(image) %>"
    alt="<%= alt %>"
    style="width:auto; height:<%= height %>px;"/>
<% else %>
  <image>
    <source type="image/webp"
      srcset="<%= cdn_proxy_url(image.variant(convert: :webp, resize_to_limit: [nil, height])) %>,
        <%= cdn_proxy_url(image.variant(convert: :webp, resize_to_limit: [nil, height*2])) %> 2x,
        <%= cdn_proxy_url(image.variant(convert: :webp, resize_to_limit: [nil, height*3])) %> 3x"
      >
    <img class="<%= classes %>"
      height="<%= height %>"
      src="<%= cdn_proxy_url(image.variant(resize_to_limit: [nil, height])) %>"
      alt="<%= alt %>"
      srcset="<%= cdn_proxy_url(image.variant(resize_to_limit: [nil, height])) %>,
              <%= cdn_proxy_url(image.variant(resize_to_limit: [nil, height*2])) %> 2x,
              <%= cdn_proxy_url(image.variant(resize_to_limit: [nil, height*3])) %> 3x"
      style="width:auto;"
      />
  </image>
<% end %>