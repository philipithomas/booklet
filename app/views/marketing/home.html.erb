<div class="container">
  <div class="prose dark:prose-invert">
    <h1><%= t('booklet') %></h1>

    <p>Some of our communities:</p>

    <ul>
      <% Community.where(visibility: :public).order(created_at: :asc).each do |c| %>
        <li>
          <a href="<%= "#{request.protocol}#{c.host}#{request.port_string}" %>">
            <%= c.name %>
          </a>
          (<%= c.host %>)
        </li>
      <% end %>
    </ul>

    <p>
      Or, check out the <%= link_to "Editor", "#{request.protocol}#{Rails.configuration.editor_host}#{request.port_string}" %> or <%= link_to "API", "#{request.protocol}#{Rails.configuration.api_host}#{request.port_string}" %>.
    </p>
  </div>

  <div class="flex items-center space-x-4 mt-8">
    <a class="btn btn-primary" href="<%= "#{request.protocol}#{Rails.configuration.signup_host}#{request.port_string}" %>">
      Sign up
    </a>
    <%= link_to "Sign in", index_url(host: Rails.configuration.index_host), class: "link" %>
  </div>
