<% content_for :heading do %><%= title t(".change_your_password") %><% end %>

<%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }, builder: Bklt::FormBuilder) do |f| %>
  <div class="form-space">
    <%= f.error_notification %>

    <%= f.input :reset_password_token, as: :hidden %>
    <%= f.full_error :reset_password_token %>

    <%= f.input :password,
                label: t(".new_password"),
                required: true,
                autofocus: true,
                hint: (t('devise.shared.minimum_password_length', count: @minimum_password_length) if @minimum_password_length),
                input_html: { autocomplete: "new-password" } %>
    <%= f.input :password_confirmation,
                label: t(".confirm_new_password"),
                required: true,
                input_html: { autocomplete: "new-password" } %>

    <%= f.hidden_field :community_id, value: @community.id %>

    <%= f.button :submit_dynamic, label: t(".change_my_password"), full_width: true %>
  </div>
<% end %>
