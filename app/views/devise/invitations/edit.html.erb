<% content_for :heading do %><%= title t("devise.invitations.edit.header") %><% end %>

<%= simple_form_for(resource, as: resource_name, url: "/invitation", html: { method: :put }, builder: Bklt::FormBuilder) do |f| %>
  <div class="form-space">
    <%= f.error_notification %>

    <%= f.hidden_field :invitation_token %>

    <%= f.input :email, disabled: true %>

    <%= f.input :name,
                required: true,
                input_html: { autocomplete: "name" } %>

    <%= f.button :submit_dynamic, label: t("devise.invitations.edit.submit_button"), full_width: true %>
  </div>
<% end %>

<%= render "components/legalese/agree_terms" %>