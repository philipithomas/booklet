<% content_for :heading do %>Speak friend and enter<% end %>

<% noindex %>

<%= simple_form_for(Editor.new, as: :editor, url: session_path(resource_name)) do |f| %>
  <div class="form-space">
    <%= f.input :email,
                required: false,
                autofocus: true,
                input_html: { autocomplete: "email" } %>
    <%= f.input :password,
                required: false,
                input_html: { autocomplete: "current-password" } %>
    <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>

    <%= f.button :submit, "Log in" %>

  </div>

<% end %>

<%= render "editors/shared/links" %>
