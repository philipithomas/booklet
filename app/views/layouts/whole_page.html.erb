<% content_for :content do %>
<div class="h-full min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <% if @community.present? %>
    <% cache [@community, 'icon_display'] do %>
    <% if @community.id && @community.icon.attached? %>
    <div class="mb-6 mx-auto flex justify-center">
      <%# Intentionally no link to avoid redirecting logged-in users to unintentional places %>
      <a href="<%= communities_path %>">
        <%= render "components/shared/square_image_variants", image: @community.icon, size: 144, classes: "h-16 w-16", alt: @community.name %>
      </a>
    </div>
    <% end %>
    <% end %>
    <% elsif @community.blank? %>
    <div class="mb-6 mx-auto flex justify-center">
      <a href="/">
        <img class="h-16 w-auto" width="64" height="64" src="<%= asset_path("logo/icon.png") %>" alt="<%= t("booklet") %>">
      </a>
    </div>
    <% end %>

    <div>
      <h1 class="text-center page-title"><%= yield(:heading) %></h1>
      <% if content_for?(:subheading) %>
      <p class="mt-2 text-center text-sm text-gray-600 dark:text-gray-400">
        <%= yield(:subheading) %>
      </p>
      <% end %>
    </div>
    <%= content_for?(:whole_page_content) ? yield(:whole_page_content) : yield %>
  </div>
</div>
<% end %>

<%= render template: "layouts/application" %>