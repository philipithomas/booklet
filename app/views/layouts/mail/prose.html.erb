      color: <%= @community.brand_color %>;
      text-decoration: underline;
    <% else %>
      color: #222222;
      text-decoration-color: <%= @community.brand_color %>;
      text-underline-color: <%= @community.brand_color %>;
    <% end %>
}
.prose > div, .prose > h1, .prose > h2, .prose h3, .prose > action-text-attachment, .prose > pre{
  padding-top: 12px;
