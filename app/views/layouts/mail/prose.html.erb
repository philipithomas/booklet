<body>
  <% if content_for?(:summary) %>
    <div class="hidden">
      <%= yield(:summary).truncate(100, separator: '.') %> &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &zwnj;
        &#160;&#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &#847; &zwnj;
        &#160;&#847; &#847; &#847; &#847; &#847;
    </div>
  <% end %>
  <div role="article" aria-roledescription="email" aria-label="<%= message.subject %>" lang="en">
  <table class="w-full font-sans text-base font-normal" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td align="center" class="pt-24 sm-pt-0">
          <table class="sm-w-full" cellpadding="0" cellspacing="0" role="presentation" style="width: 100%; max-width: 600px;">
            <% if content_for?(:preamble) %>
            <tr>
              <td align="center">
                <p class="mt-1_5 text-xs leading-6 text-center text-gray-600" style="line-height: 1.2rem; padding-bottom: 10px;">
                  <%= yield(:preamble) %>
                </p>
              </td>
            </tr>
            <% end %>
            <tr>
              <td align="center">
                <table class="w-full" cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td class="px-24 text-base text-left text-gray-900 lg-px-48 sm-px-24 leading-20 prose">
                      <%= content_for?(:content) ? yield(:content) : yield %>

                    </td>
                  </tr>
                  <tr>
                    <td class="h-8"></td>
                  </tr>
									<tr>
										<td class="px-24 lg-px-48">
											<div style="height: 1px;" class="w-full"></div>
										</td>
									</tr>

                  <% if @author %>
                  <tr>
                    <td class="px-24 lg-px-48 sm-px-24">
                      <table class="mx-0" style="margin: 0 0 12px 0" cellpadding="0" cellspacing="0" role="presentation">
                        <tbody>
                          <tr>
                            <td>
                              <div>
                                <a href="<%= member_url(@author, host: @community.host, email_token: @email_token || "") %>" target="_blank">
                                    <div>
                                      <%= image_tag @author.photo.attached? ? @author.photo.variant(resize_to_fill: [88, 88, { crop: :attention }]).processed : (@community.icon.attached? ? @community.icon.variant(resize_to_fill: [88, 88, { crop: :attention }]).processed : asset_path('logo/icon.png')),
                                        width: 44, height: 44,
                                        class: @author.photo.attached? ? "border-0 rounded-full h-44 w-44" : "border-0 h-44 w-44",
                                        alt: @author.photo.attached? ? @author.name : I18n.t('booklet') %>
                                    </div>
                                </a>
                              </div>
                            </td>
                            <td>
                              <div class="ml-12 leading-tight">
                                <div class="text-sm leading-tight text-gray-900">
                                  <a href="<%= member_url(@author, host: @community.host , email_token: @email_token || "") %>" class="font-medium text-gray-800 no-underline" target="_blank">
                                    <%= @author.name %>
                                  </a>
                                </div>
                                <table style="margin:4px 0 0 0" cellspacing="0" cellpadding="0" role="presentation">
                                  <tbody>
                                    <tr>
                                      <td class="py-2 ml-12 text-xs text-gray-700 align-middle">
                                        <% if @post.present? %>
                                          <%= time_tag @post.published_at do %>
                                            <%= @post.published_at.strftime('%B %-d, %Y') %>
                                          <% end %>
                                        <% else %>
                                          <a href="<%= @community.url %>" class="font-normal text-gray-800 no-underline" target="_blank">
                                            <%= @community.host %>
                                          </a>
                                        <% end %>
                                      </td>
                                    </tr>
                                  </tbody>
                                </table>
                              </div>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                  <% end %>

                  <% if content_for?(:button_label) and content_for?(:button_link) %>
                  <tr>
                    <td class="h-24"></td>
                  </tr>
                  <tr>
                    <td class="px-24 text-base text-left text-gray-900 lg-px-48 sm-px-24 leading-20">
                      <div class="leading-full" style="text-align: center">
                        <a href="<%= yield :button_link %>" class="btn btn-primary">
                          <!--[if mso]><i style="letter-spacing: 24px; mso-font-width: -100%; mso-text-raise:30px;">&#8202;</i><![endif]-->
                          <span style="mso-text-raise: 16px;"><%= yield :button_label %></span>
                          <!--[if mso]><i style="letter-spacing: 24px; mso-font-width: -100%;">&#8202;</i><![endif]-->
                        </a>
                      </div>
                    </td>
                  </tr>
                  <% end %>

                  <tr>
                    <td class="px-24 pb-16 text-xs text-left text-gray-500 lg-px-48 pt-24">
                      <% if @email_token.present? %>
                        <p class="mt-1_5 mb-5 text-xs leading-6 text-center text-gray-500 font-normal">
                          <a href="<%= notification_preference_url(token: @email_token, host: @community.host) %>" class="underline text-gray-700"><%= t('mailers.update_preferences_or_unsubscribe') %></a>
                        </p>
                      <% end %>

                      <%= render 'layouts/mail/legalese' %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
