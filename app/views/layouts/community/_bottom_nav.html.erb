<div class="bg-white dark:bg-gray-900 z-30 w-full shadow md:hidden fixed inset-x-0 bottom-0 z-30 md:hidden"
  data-turbo-permanent="">
    <nav class="grid grid-cols-<%= menuItems.length + 1 %>" aria-label="Global">
      <% menuItems.each do |item| %>
        <a
          href="<%= item[:to] %>"
          <% if item[:active] %>
            aria-current="page"
            class="flex flex-col items-center justify-center px-3 py-2 text-xs font-medium text-black dark:text-white"
          <% else %>
            class="flex flex-col items-center justify-center px-3 py-2 text-xs font-medium text-gray-800 dark:text-gray-200"
          <% end %>
          >

          <div class="pb-2">
            <%= heroicon item[:icon], options: { class: "w-5 h-5" }, variant: item[:active] ? :solid : :outline %>
          </div>

          <%= item[:name] %>
        </a>
      <% end %>

      <%# Account dropdown %>
      <div
        data-controller="dropdown"
        class="relative flex items-center justify-center">
        <button
          data-action="dropdown#toggle click@window->dropdown#hide"
          class="flex flex-col items-center justify-center px-3 py-2 text-xs font-medium text-gray-800 dark:text-gray-200"
          >

          <div class="pb-2">
            <%= heroicon 'bars-3', options: { class: "w-5 h-5" }, variant: :outline  %>
          </div>

          More
        </a>


        <div
          data-dropdown-target="menu"
          class="bottom-0 right-0 hidden my-12 mr-2 origin-bottom-right dropdown-menu"
          role="menu"
          aria-orientation="vertical"
          aria-labelledby="user-menu-button"
          data-transition-enter-from="opacity-0 scale-95"
          data-transition-enter-to="opacity-100 scale-100"
          data-transition-leave-from="opacity-100 scale-100"
          data-transition-leave-to="opacity-0 scale-95"
          tabindex="-1">
          <% secondaryMenuItems.each do |menuItem| %>
            <% if menuItem[:show] %>
              <a
                href="<%= menuItem[:to] %>"
                class="dropdown-menu-item"
                role="menuitem"
                tabindex="-1"
                <% if menuItem[:newTab] %>target="_blank" rel="noopener"<% end %>
                <% if menuItem[:data] %>
                  <% menuItem[:data].each do |key, value| %>
                    data-<%= key %>="<%= value %>"
                  <% end %>
                <% end %>
                >
                <%= menuItem[:name] %>
              </a>
            <% end %>
          <% end %>
        </div>
      </div>
    </nav>
  </div>
</div>
