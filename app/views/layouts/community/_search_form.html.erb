


<form action="<%= search_index_path %>" accept-charset="UTF-8" method="get"
  <% if local_assigns[:enable_data_action] %>
    data-action="submit->search-palette#handleSubmit"
  <% end %>
  <% if local_assigns[:enable_data_target] %>
    data-search-palette-target="form"
  <% end %>
>
  <div class="mx-auto max-w-prose transform divide-y divide-gray-100 dark:divide-gray-900 overflow-hidden rounded-xl bg-white dark:bg-black  <% if local_assigns[:enable_data_action] %>ring-1 ring-black dark:ring-white ring-opacity-5 dark:ring-opacity-20 <% end %> border border-gray-200 dark:border-gray-800 transition-all">
    <div class="flex w-full">
      <input
        type="text"
        name="q"
        class="h-12 w-full border-0 bg-transparent pr-11 pl-4 text-gray-900 dark:text-gray-100 placeholder:text-gray-400 dark:placeholder:text-gray-600 focus:ring-0 sm:text-sm flex-grow "
        placeholder="<%= t('search') %> . . ."
        value="<%= local_assigns[:query] || '' %>"
        <% if local_assigns[:enable_data_target] %>
          data-search-palette-target="input"
        <% end %>
        >
      <button
        type="submit"
        class="flex items-center shrink-0"
        >
        <svg class="absolute right-4 top-3.5 h-5 w-5 text-gray-500 hover:text-black dark:hover:text-white" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </div>
</form>
