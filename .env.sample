# Booklet (BKLT) Environment Variables
# Copy this file to .env and fill in values as needed.
# Most variables are optional — the app runs in solo mode with no external services by default.

# Application Mode: SOLO (default) or MULTIUSER
# APP_MODE=SOLO

# Base host for the application (default: localtest.me in development)
# BASE_HOST=localtest.me

# Production only: Rails secret (generate with `rails secret`) and database
# SECRET_KEY_BASE=
# DATABASE_URL=

# Email delivery via Postmark (optional — falls back to letter_opener in development)
# POSTMARK_API_TOKEN=

# From address for outgoing email (default: no-reply@BASE_HOST)
# In production, set this to an address on a domain your email provider has verified.
# DEFAULT_EMAIL_FROM=

# Admin/support email addresses
# ADMIN_EMAIL=admin@example.com
# SUPPORT_EMAIL=support@example.com

# Physical mailing address appended to email footers (optional, e.g. for CAN-SPAM compliance)
# MAILING_ADDRESS=

# Business details shown on Stripe receipts (MULTIUSER mode only)
# BUSINESS_NAME=
# BUSINESS_ADDRESS=

# From address used for SMTP email validation via Truemail (default: hello@example.com)
# TRUEMAIL_VERIFIER_EMAIL=

# Plausible analytics script URL (optional — no analytics when unset, production only)
# PLAUSIBLE_SCRIPT_URL=

# OpenAI (optional — enables content moderation, newsletter summarization, search embeddings)
# OPENAI_API_KEY=
# OPENAI_ORG_ID=

# Chroma vector database (optional — enables semantic search)
# CHROMA_HOST=
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# AWS S3 (optional — required for production file storage, development uses local disk)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-1
# AWS_STORAGE_BUCKET=

# Stripe (optional — only used in MULTIUSER mode for billing)
# STRIPE_PRIVATE_KEY=
# STRIPE_PUBLIC_KEY=
# STRIPE_SIGNING_SECRET=
# STRIPE_PLAN_ID=

# Custom domains (MULTIUSER mode): IPv4 shown in apex-domain DNS instructions
# APEX_DNS_IP=

# hCaptcha (optional — bot protection for contact forms)
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=

# Fly.io (optional — custom domain certificate management in MULTIUSER mode)
# FLY_API_TOKEN=
# FLY_APP_ID=

# Admin chat notifications (optional — posts to a webhook URL, e.g. Discord/Slack).
# Note: signup notifications sent here include member email addresses.
# ADMIN_CHAT_URL=

# Newsletter signup API (optional — subscribes admins to an external newsletter)
# JUNK_DRAWER_API_URL=

# Active Record Encryption (required for production — run `rails db:encryption:init` to generate)
# Development/test use built-in defaults if not set.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
